{
  "name": "the-witches-road",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.14.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:release": "playwright test --config playwright.release.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "idb": "8.0.4",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.14.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.7",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
